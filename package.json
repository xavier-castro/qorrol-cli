{
  "name": "qorrol",
  "version": "1.0.14",
  "description": "A CLI tool for creating projects from curated templates",
  "keywords": [
    "boilerplate",
    "cli",
    "generator",
    "project",
    "scaffold",
    "template"
  ],
  "homepage": "https://github.com/xavier-castro/qorrol-cli#readme",
  "bugs": {
    "url": "https://github.com/xavier-castro/qorrol-cli/issues"
  },
  "license": "MIT",
  "author": "Backpine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavier-castro/qorrol-cli.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./issue-tracker": "./dist/issue-tracker/index.js",
    "./triage": "./dist/triage/index.js",
    "./processes": "./dist/processes/index.js",
    "./scaffolding": "./dist/scaffolding/index.js"
  },
  "bin": {
    "qorrol": "./bin/qorrol"
  },
  "files": [
    "dist/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.1",
    "jsonc-parser": "^3.3.1",
    "ora": "^8.2.0",
    "simple-git": "^3.28.0",
    "validate-npm-package-name": "^6.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}